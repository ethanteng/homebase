# Copy this to .env beside it and fill it in. .env is never committed.

# The reseller API key, from the profile page of your IDrive e2 reseller account.
IDRIVE_RESELLER_TOKEN=

# Each run's test user gets this address, with {id} replaced by the run's id. Use a domain you
# control. Nothing asks iDrive to send it mail, but it has to be an address nobody else could own.
SPIKE_EMAIL=spike-{id}@example.com

# Optional. Which region_key to use; "node spike.mjs regions" lists them. Otherwise the first
# active one.
IDRIVE_REGION=

# Optional. The region name S3 requests are signed for. If the endpoint wants a different one,
# the run switches to it and says so.
IDRIVE_S3_REGION=

# Optional. Which restic to run, if it isn't the one on the PATH.
RESTIC_BINARY=
