<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Only HTTPS through the system, which needs no export paperwork; saying so here saves
	     answering the question for every TestFlight build. -->
	<key>ITSAppUsesNonExemptEncryption</key>
	<false/>
	<!-- Quick Look's share sheet offers Save Image and Save Video, which crash without this. -->
	<key>NSPhotoLibraryAddUsageDescription</key>
	<string>Uncloud saves the photos and videos you choose to your photo library.</string>
</dict>
</plist>
